{
  "name": "@dega/cardano-registry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "imports": {
    "#*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "demo": "npm run build && node dist/demo.js",
    "cli": "node dist/cli.js",
    "lint": "oxlint --deny-warnings src test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "format:check": "prettier --check src test/*.ts package.json tsconfig.json",
    "benchmark:mpf": "npm run build && vitest run test/mpf-benchmark.test.ts"
  },
  "dependencies": {
    "@lucid-evolution/lucid": "0.6.5",
    "@noble/curves": "2.4.0",
    "@aiken-lang/merkle-patricia-forestry": "1.3.1",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "cbor-extract": false,
    "fsevents": false
  }
}
